import os
import subprocess
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.scrollview import ScrollView
from kivy.core.window import Window
from kivy.metrics import dp

Window.clearcolor = (0.12, 0.14, 0.18, 1)

ADB = "adb"

def get_default_resolution():
    try:
        out = subprocess.check_output([ADB, "shell", "wm", "size"], stderr=subprocess.DEVNULL).decode().strip()
        for line in out.split("\n"):
            if "Physical" in line:
                parts = line.split(":")[1].strip().split("x")
                return int(parts[0]), int(parts[1])
    except:
        pass
    return 1080, 2400

def set_resolution(w, h):
    subprocess.run([ADB, "shell", "wm", "size", f"{w}x{h}"], capture_output=True)

def reset_resolution():
    subprocess.run([ADB, "shell", "wm", "size", "reset"], capture_output=True)

def adb_connect():
    subprocess.run([ADB, "connect", "127.0.0.1:5555"], capture_output=True)

PRESETS = [
    ("Полный экран", None),
    ("21:9 Ультра-широкий", (21, 9)),
    ("32:9 Супер-широкий", (32, 9)),
    ("1:1 Квадрат", (1, 1)),
    ("4:3 Классика", (4, 3)),
    ("16:9 Стандарт", (16, 9)),
    ("3:2 Баланс", (3, 2)),
]

class ResolutionApp(App):
    def build(self):
        self.default_w, self.default_h = get_default_resolution()
        self.title = "MC Bedrock Resizer"

        root = ScrollView(size_hint=(1, 1))
        main = BoxLayout(orientation='vertical', size_hint_y=None, padding=dp(20), spacing=dp(12))
        main.bind(minimum_height=main.setter('height'))

        title = Label(
            text="MC Bedrock\nScreen Resizer",
            font_size=dp(28),
            bold=True,
            color=(0.35, 0.8, 1, 1),
            size_hint_y=None,
            height=dp(70),
            halign='center'
        )
        main.add_widget(title)

        info = Label(
            text=f"Разрешение: {self.default_w}x{self.default_h}",
            font_size=dp(14),
            color=(0.6, 0.6, 0.7, 1),
            size_hint_y=None,
            height=dp(30)
        )
        self.info_label = info
        main.add_widget(info)

        presets_label = Label(
            text="-- Быстрые пресеты --",
            font_size=dp(16),
            color=(0.5, 0.5, 0.55, 1),
            size_hint_y=None,
            height=dp(30)
        )
        main.add_widget(presets_label)

        grid = GridLayout(cols=2, size_hint_y=None, spacing=dp(10))
        grid.bind(minimum_height=grid.setter('height'))

        for name, ratio in PRESETS:
            btn = Button(
                text=name,
                font_size=dp(15),
                size_hint_y=None,
                height=dp(55),
                background_color=self._btn_color(ratio)
            )
            btn.bind(on_release=lambda inst, r=ratio: self.apply_preset(r))
            grid.add_widget(btn)

        main.add_widget(grid)

        custom_label = Label(
            text="-- Свои размеры --",
            font_size=dp(16),
            color=(0.5, 0.5, 0.55, 1),
            size_hint_y=None,
            height=dp(30)
        )
        main.add_widget(custom_label)

        input_row = BoxLayout(orientation='horizontal', size_hint_y=None, height=dp(50), spacing=dp(10))
        self.w_input = TextInput(
            text=str(self.default_w),
            font_size=dp(18),
            multiline=False,
            input_filter='int',
            halign='center'
        )
        x_label = Label(text="x", font_size=dp(24), size_hint_x=0.1)
        self.h_input = TextInput(
            text=str(self.default_h),
            font_size=dp(18),
            multiline=False,
            input_filter='int',
            halign='center'
        )
        apply_btn = Button(
            text="Применить",
            font_size=dp(16),
            size_hint_x=0.3,
            background_color=(0.2, 0.7, 0.3, 1)
        )
        apply_btn.bind(on_release=self.apply_custom)
        input_row.add_widget(self.w_input)
        input_row.add_widget(x_label)
        input_row.add_widget(self.h_input)
        input_row.add_widget(apply_btn)
        main.add_widget(input_row)

        reset_btn = Button(
            text="Сбросить разрешение",
            font_size=dp(16),
            size_hint_y=None,
            height=dp(50),
            background_color=(0.8, 0.3, 0.3, 1)
        )
        reset_btn.bind(on_release=self.do_reset)
        main.add_widget(reset_btn)

        self.status = Label(
            text="",
            font_size=dp(14),
            color=(0.4, 0.8, 0.4, 1),
            size_hint_y=None,
            height=dp(30)
        )
        main.add_widget(self.status)

        hint = Label(
            text="Открой Minecraft после применения\nСбрось разрешение когда закончишь играть",
            font_size=dp(13),
            color=(0.45, 0.45, 0.5, 1),
            size_hint_y=None,
            height=dp(50),
            halign='center'
        )
        main.add_widget(hint)

        root.add_widget(main)

        adb_connect()
        self.default_w, self.default_h = get_default_resolution()
        self.info_label.text = f"Разрешение: {self.default_w}x{self.default_h}"

        return root

    def _btn_color(self, ratio):
        if ratio is None:
            return (0.25, 0.55, 0.85, 1)
        return (0.3, 0.35, 0.45, 1)

    def apply_preset(self, ratio):
        if ratio is None:
            w, h = self.default_w, self.default_h
        else:
            rw, rh = ratio
            if self.default_w >= self.default_h:
                h = self.default_h
                w = int(h * rw / rh)
            else:
                w = self.default_w
                h = int(w * rh / rw)
        set_resolution(w, h)
        self.status.text = f"Установлено: {w}x{h}"
        self.info_label.text = f"Разрешение: {w}x{h}"

    def apply_custom(self, *args):
        try:
            w = int(self.w_input.text) if self.w_input.text else self.default_w
            h = int(self.h_input.text) if self.h_input.text else self.default_h
            if w < 100 or h < 100:
                self.status.text = "Минимум 100x100"
                return
            set_resolution(w, h)
            self.status.text = f"Установлено: {w}x{h}"
            self.info_label.text = f"Разрешение: {w}x{h}"
        except:
            self.status.text = "Ошибка ввода"

    def do_reset(self, *args):
        reset_resolution()
        self.status.text = "Сброшено до заводского"
        self.info_label.text = f"Разрешение: {self.default_w}x{self.default_h}"


if __name__ == '__main__':
    ResolutionApp().run()
